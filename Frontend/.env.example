# Frontend build-time environment
#
# Leave empty in development so requests hit the Vite dev proxy (/api -> http://127.0.0.1:5000).
# In production set this to the deployed API URL (the Render backend service), e.g.:
#   VITE_API_URL=https://nathan-portfolio-api.onrender.com
# Set it in the Vercel dashboard: Project → Settings → Environment Variables (Production + Preview).
VITE_API_URL=
