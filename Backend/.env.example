# Flask backend for the Nathan N.O portfolio
PORT=5000
HOST=127.0.0.1
FLASK_DEBUG=1

# Set DB=1 to use PostgreSQL below. Any other value (or unset) falls back to
# the local SQLite file for offline dev.
DB=0

# PostgreSQL connection string. Required when DB=1; the API fails to start
# (or returns 503) if this is unset or unreachable.
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# SQLite database file (only used with the SQLite fallback; defaults to ./portfolio.db)
DATABASE_PATH=

# Optional: require this token on /api/admin/* routes
ADMIN_TOKEN=
