# Flask backend for the Nathan N.O portfolio
PORT=5000
HOST=127.0.0.1
FLASK_DEBUG=1

# Set SQLITE=1 to use the local SQLite file (offline dev). Any other value
# (or unset) uses PostgreSQL below.
SQLITE=0

# PostgreSQL connection string. Required when SQLITE is not enabled; the API
# fails to start (or returns 503) if this is unset or unreachable.
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# SQLite database file (only used when SQLITE=1; defaults to ./portfolio.db)
DATABASE_PATH=

# Optional: require this token on /api/admin/* routes
ADMIN_TOKEN=
