# =============================================================================
# Nathan N.O — Video Editor portfolio · booking/inquiry API configuration
# For local dev: copy this file to `.env` and fill in the values, then run
# `npm run dev`. For production: set the same keys in your host (e.g. Vercel →
# Settings → Environment variables).
# =============================================================================

# --- Client (build-time, VITE_ prefix gets inlined into the bundle) ----------
# Set to 'false' to keep the form in demo mode (confirm locally, no network).
# Any other value (or unset) posts to the API below.
VITE_BOOKINGS_API=true

# Optional: override the booking API endpoint.
# Defaults to the Render-hosted Flask backend.
# VITE_BOOKINGS_API_URL=https://nathan-portfolio-backend-api.onrender.com/api/bookings
